<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT                                    -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="#123A8C"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="RentPe"
                    android:textColor="#123A8C"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#123A8C"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- WELCOME                                           -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="#777C88"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hello, Smit"
                        android:textColor="#073681"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/profile_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_image" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEARCH                                             -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/search_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:elevation="3dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#747A88"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Search for your dream home..."
                    android:textColor="#777C88"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PROPERTY CATEGORIES                               -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="52dp"
                        android:background="@drawable/category_selected"
                        android:gravity="center"
                        android:text="▦  Apartment"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="115dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/category_unselected"
                        android:gravity="center"
                        android:text="⌂  Villa"
                        android:textColor="#50545E"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="115dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/category_unselected"
                        android:gravity="center"
                        android:text="⌂  Studio"
                        android:textColor="#50545E"
                        android:textSize="16sp" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- FEATURED HEADER                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="28dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Featured Properties"
                    android:textColor="#073681"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFeaturedViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#0758D6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- FEATURED CARDS                                    -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="20dp">

                    <!-- FEATURED CARD 1 -->

                    <LinearLayout
                        android:layout_width="310dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/property_card"
                        android:elevation="4dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="185dp"
                            android:contentDescription="Skyview Terrace"
                            android:scaleType="centerCrop"
                            android:src="@drawable/property_one" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Skyview Terrace"
                                    android:textColor="#20242A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$2,400"
                                    android:textColor="#073681"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="⌖  Manhattan, NY"
                                android:textColor="#858995"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/btnBookVisitOne"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/login_button"
                                android:text="Book Visit"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- FEATURED CARD 2 -->

                    <LinearLayout
                        android:layout_width="310dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/property_card"
                        android:elevation="4dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="185dp"
                            android:contentDescription="Azure Villa"
                            android:scaleType="centerCrop"
                            android:src="@drawable/property_two" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Azure Villa"
                                android:textColor="#20242A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="⌖  Malibu, CA"
                                android:textColor="#858995"
                                android:textSize="14sp" />

                            <Button
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/login_button"
                                android:text="Book Visit"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- NEARBY HEADER                                     -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="28dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nearby Properties"
                    android:textColor="#073681"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNearbyViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#0758D6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NEARBY PROPERTY 1                                 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/property_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="101dp"
                    android:contentDescription="Cozy Loft Studio"
                    android:scaleType="centerCrop"
                    android:src="@drawable/property_three" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cozy Loft Studio"
                        android:textColor="#20242A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="⌖  2.4 miles away"
                        android:textColor="#858995"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="$1,200/mo"
                        android:textColor="#073681"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="★ 4.5"
                    android:textColor="#0758D6"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NEARBY PROPERTY 2                                 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/property_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="101dp"
                    android:contentDescription="The Highline Suite"
                    android:scaleType="centerCrop"
                    android:src="@drawable/property_four" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Highline Suite"
                        android:textColor="#20242A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="⌖  0.8 miles away"
                        android:textColor="#858995"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="$3,100/mo"
                        android:textColor="#073681"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="★ 4.7"
                    android:textColor="#0758D6"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- Bottom spacing -->

            <View
                android:layout_width="match_parent"
                android:layout_height="110dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- FIXED BOTTOM NAVIGATION                              -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bottom_navigation"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/category_selected"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nSearch"
            android:textColor="#555A66"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="□\nBookings"
            android:textColor="#555A66"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nFavorites"
            android:textColor="#555A66"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#555A66"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>