<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="200dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- ================= HEADER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="#F8FAFD"
                android:gravity="center_vertical"
                android:paddingStart="25dp"
                android:paddingEnd="25dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#062D7A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Book a Visit"
                    android:textColor="#062D7A"
                    android:textSize="32sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================= PROPERTY CARD ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="55dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_white_card"
                android:elevation="3dp"
                android:orientation="horizontal"
                android:padding="25dp">

                <ImageView
                    android:id="@+id/imgProperty"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:contentDescription="Property Image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/property_one" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPropertyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skyline Azure&#10;Penthouse"
                        android:textColor="#062D7A"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Location"
                            android:src="@drawable/ic_location"
                            app:tint="#505560" />

                        <TextView
                            android:id="@+id/txtLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Bandra West, Mumbai"
                            android:textColor="#505560"
                            android:textSize="17sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtBhk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_bhk"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp"
                            android:text="2+ BHK"
                            android:textColor="#0056D6"
                            android:textSize="15sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹85,000"
                            android:textColor="#062D7A"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/mo"
                            android:textColor="#444A55"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================= SELECT DATE ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="45dp"
                android:layout_marginEnd="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Date"
                    android:textColor="#202328"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnPreviousMonth"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous Month"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#555B66" />

                <TextView
                    android:id="@+id/txtMonth"
                    android:layout_width="145dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="August 2026"
                    android:textColor="#0056D6"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next Month"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#555B66" />

            </LinearLayout>


            <!-- ================= CALENDAR ================= -->

            <LinearLayout
                android:id="@+id/calendarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:rowCount="7" />

            </LinearLayout>


            <!-- ================= SELECT TIME ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="45dp"
                android:text="Select Time"
                android:textColor="#202328"
                android:textSize="27sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/timeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="32dp"
                android:columnCount="3"
                android:rowCount="2">

                <TextView
                    android:id="@+id/time10"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="10:00 AM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/time1130"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="11:30 AM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/time1400"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="02:00 PM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/time1530"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="03:30 PM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/time1700"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="05:00 PM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/time1830"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_time_slot"
                    android:gravity="center"
                    android:text="06:30 PM"
                    android:textColor="#454A55"
                    android:textSize="17sp" />

            </GridLayout>


            <!-- ================= VISIT DETAILS ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="45dp"
                android:text="Visit Details"
                android:textColor="#202328"
                android:textSize="27sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="40dp"
                android:orientation="horizontal">

                <!-- VISITORS -->

                <LinearLayout
                    android:id="@+id/visitorCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Visitors"
                        android:src="@drawable/ic_people"
                        app:tint="#0056D6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Visitors"
                        android:textColor="#202328"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVisitors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Just me (1 person)"
                        android:textColor="#777C88"
                        android:textSize="15sp" />

                </LinearLayout>


                <!-- ADD NOTE -->

                <LinearLayout
                    android:id="@+id/noteCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Add Note"
                        android:src="@drawable/ic_note"
                        app:tint="#0056D6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add Note"
                        android:textColor="#202328"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Special request"
                        android:textColor="#777C88"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM BOOKING BAR ================= -->

    <LinearLayout
        android:id="@+id/bottomBookingBar"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="#F8FAFD"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="18dp"
        android:paddingEnd="40dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking for"
            android:textColor="#777C88"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Wed, 19 Aug at 02:00 PM"
            android:textColor="#202328"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_confirm_button"
            android:text="Confirm Booking"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>